# Copy to .env.local for local development. In Vercel set these under
# Project → Settings → Environment Variables (Production + Preview).

# Supabase → Project Settings → API. The service-role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared team password for signing in to the site.
APP_PASSWORD=
# Optional: separate secret for signing session cookies (defaults to APP_PASSWORD).
SESSION_SECRET=

# Any long random string. Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=

# Public URL of the site, used for links in emails (optional on Vercel).
APP_URL=https://northgate-alertguard.vercel.app

# Email option A (recommended): Gmail with an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourteam@gmail.com
SMTP_PASS=
EMAIL_FROM="Northgate AlertGuard <yourteam@gmail.com>"

# Email option B: Resend (https://resend.com). Needs a verified domain to email
# people other than the account owner.
RESEND_API_KEY=
