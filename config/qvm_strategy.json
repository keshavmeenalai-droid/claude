  "quality_gate": {
    "all_must_pass": true,
    "G1_investable": "market cap >= P1, price >= $3, >= 5 years of financial statements, not an excluded sector",
    "G2_profitable": "ROIC (TTM; last FY if blank) >= P2 AND net income > 0 in >= 4 of last 5 fiscal years",
    "G3_solvent": "operating income / interest expense (last FY) >= P3; if blank, debt / EBITDA <= 1.5",
