    "data_rule": "No data, no trade: a blank or unverifiable gate input fails the gate"
  },
  "scoring": {
    "pool": "All companies that pass the quality gate on the run date",
    "currency": "Growth, FCF yield and momentum converted to USD",
    "metrics": [
      {
        "id": "Q1",
        "pillar": "Q",
        "name": "ROIC",
        "formula": "ROIC TTM (last FY if blank)",
        "better": "higher"
      },
      {
        "id": "Q2",
        "pillar": "Q",
        "name": "Gross profitability",
        "formula": "gross_margin_pct * asset_turnover / 100",
        "better": "higher"
      },
      {
        "id": "Q3",
        "pillar": "Q",
        "name": "Revenue growth 5y (USD)",
        "formula": "5-year revenue CAGR in USD",
        "better": "higher"
      },
      {
        "id": "V1",
        "pillar": "V",
        "name": "FCF yield",
        "formula": "100 / price_to_fcf  (or FCF / market cap * 100)",
        "better": "higher"
      },
      {
        "id": "V2",
        "pillar": "V",
        "name": "Earnings yield",
        "formula": "100 / pe",
        "better": "higher"
      },
      {
        "id": "V3",
        "pillar": "V",
        "name": "P/E position in 5y range",
        "formula": "(pe - pe_min_5y) / (pe_max_5y - pe_min_5y); 5y range from P/E now and 1, 3, 5 years back",
        "better": "lower"
      },
      {
        "id": "M1",
        "pillar": "M",
        "name": "12-1 momentum (USD)",
        "formula": "((1 + ret_52w/100) / (1 + ret_30d/100) - 1) * 100",
        "better": "higher"
      },
      {
        "id": "M2",
        "pillar": "M",
        "name": "Trend strength",
        "formula": "(price / ma200 - 1) * 100",
        "better": "higher"
      }
    ],
    "percentile": "Rank each metric 0-100 across the pool (PERCENTRANK.INC * 100; ties share the average rank). For 'lower' metrics use 100 - rank. Blank metric = skipped, never filled.",
    "pillar_score": "Mean of the pillar's available metric percentiles",
    "qvm": "0.40 * Q + 0.30 * V + 0.30 * M",
    "expected_return_pct": "fcf_yield_pct + clamp(min(rev_growth_3y_usd, rev_growth_5y_usd), 0, P8)",
    "volatility": "Std. dev. of 60 monthly returns (WInS Share Performance); volatile if > 0.10"
  },
  "entry_rules": {
    "all_must_pass": true,
    "E1_score": "qvm >= 60 AND min(Q, V, M) >= 25",
